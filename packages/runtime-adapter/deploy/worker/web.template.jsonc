{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zilobase-client",
  // Community entry: copy this template next to your web entry (see web.template.js)
  // and replace every <PLACEHOLDER> before deploying.
  "main": "<WEB_ENTRY>",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "<WEB_DIST_DIR>",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "<WEB_ROUTE_PATTERN>",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "API_SERVICE",
      "service": "zilobase-server"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "vars": {
    "ZILOBASE_ENVIRONMENT": "production"
  }
}
