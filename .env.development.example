# Optional third-party credentials for source development. `npm run dev:setup`
# generates isolated database, authentication, and storage values under .dev/.
OPENAI_API_KEY=
AI_MCP_ENABLED=false
AI_MCP_CUSTOM_SERVERS_ENABLED=false
AI_MCP_EXTERNAL_WRITES_ENABLED=false
AI_MCP_EXECUTION_DISABLED=false
AI_CUSTOM_AGENTS_ENABLED=false
AI_CUSTOM_AGENT_TRIGGERS_ENABLED=false
AI_CUSTOM_AGENT_EXTERNAL_EVENTS_ENABLED=false
AI_CUSTOM_AGENT_EXECUTION_DISABLED=false
MCP_CREDENTIAL_ENCRYPTION_KEYS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DESKTOP_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_SECRET=
VITE_FEATURE_NOTION_IMPORT=false
VITE_FEATURE_DATABASE_REALTIME=true
VITE_FEATURE_MAIL=false

# `npm run dev` starts this local Valkey dependency automatically.
REALTIME_REDIS_URL=redis://127.0.0.1:16379

# Gmail credentials are separate from Google application sign-in.
MAIL_ENABLED=false
GMAIL_GOOGLE_CLIENT_ID=
GMAIL_GOOGLE_CLIENT_SECRET=
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_PUSH_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT_EMAIL=
GMAIL_PUBSUB_SUBSCRIPTION=

# Optional: HTTPS tunnel forwarding to the profile WEB port (1420 or 1422).
ZILOBASE_DEV_PUBLIC_ORIGIN=

# Calendar is independently gated and requires a workspace allowlist.
CALENDAR_ENABLED=false
CALENDAR_ENABLED_WORKSPACE_IDS=
CALENDAR_GOOGLE_CLIENT_ID=
CALENDAR_GOOGLE_CLIENT_SECRET=
CALENDAR_TOKEN_ENCRYPTION_KEY=
