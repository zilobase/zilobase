# Optional third-party credentials for source development. `npm run dev:setup`
# generates isolated database, authentication, and storage values under .dev/.
OPENAI_API_KEY=
# Optional OpenAI Responses model override; defaults to GPT-6 Luna for everyday chat.
AI_MODEL=gpt-6-luna
AI_CONTEXT_WINDOW_TOKENS=32768
AI_DIAGNOSTICS_ENABLED=true
# Workspace actions the AI may perform (comma-separated milestones, e.g. A). Empty keeps Ask AI read-only.
AI_ACTION_MILESTONES=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DESKTOP_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_SECRET=
VITE_FEATURE_ASK_AI=true
VITE_FEATURE_NOTION_IMPORT=false
VITE_FEATURE_WEB_CLIPPER=false

# `npm run dev` starts this local Valkey dependency automatically.
REALTIME_REDIS_URL=redis://127.0.0.1:16379
QUEUE_REDIS_URL=redis://127.0.0.1:16380

# Optional: HTTPS tunnel forwarding to the profile WEB port (1420 or 1422).
ZILOBASE_DEV_PUBLIC_ORIGIN=

CALENDAR_GOOGLE_CLIENT_ID=
CALENDAR_GOOGLE_CLIENT_SECRET=
CALENDAR_TOKEN_ENCRYPTION_KEY=

# Durable Ask AI: migrate first, then enable on API and background worker.
AI_DURABLE_STREAMING_ENABLED=false
# Legacy version-one provider recovery only; new runs use transcript checkpoints.
AI_PROVIDER_BACKGROUND_ENABLED=false
# Same key for both processes: openssl rand -base64 32
AI_RUN_PAYLOAD_ENCRYPTION_KEY=
