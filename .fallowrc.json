    "apps/web/src/editor/extensions/database/views/database-sub-items.ts",
    "apps/web/src/editor/extensions/database/views/database-view-commands.ts",
    "apps/web/src/editor/extensions/database/views/database-view-config.ts",
    "apps/web/src/editor/extensions/database/views/database-view-model.tsx",
    "apps/web/src/editor/extensions/database/views/database-view-scroll.ts",
    "apps/web/src/editor/extensions/database/views/form/database-form-header-config.ts",
    "apps/web/src/editor/extensions/database/views/form/database-form-question-config.ts",
    "apps/web/src/editor/extensions/database/views/kanban/database-kanban-card-drag.ts",
    "apps/web/src/editor/extensions/database/views/kanban/database-kanban-config.ts",
    "apps/web/src/editor/extensions/database/views/table/database-table-selection.ts",
    "apps/web/src/editor/extensions/database/views/timeline/database-timeline-config.ts",
    "apps/web/src/editor/extensions/database/views/timeline/database-timeline-layout.ts",
    "apps/web/src/editor/extensions/database/views/timeline/database-timeline-rows.ts",
    "apps/web/src/editor/extensions/database/views/view-settings/chart-settings-model.ts",
    "apps/web/src/editor/extensions/database/views/view-settings/data-source-model.ts",
