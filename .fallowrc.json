{
  // This file is JSONC: fallow reads these comments; generic JSON tools may not.
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/index.{js,jsx,mjs}",
    "src/main.{js,jsx,mjs}",
    // The web test runner discovers these modules with fs.readdir().
    "apps/web/test/**/*.test.mjs",
    // Workspace package tests run directly through Node or Vitest.
    "packages/**/*.test.ts",
    // Root scripts are not npm workspace packages, so list them explicitly.
    "scripts/**/*.mjs",
    "apps/desktop/e2e/**/*.mjs"
  ],
  // CI workflow shell fragments are not JavaScript entrypoints. In particular,
  // Docker's {{...}} format strings are not filesystem globs.
  "ignorePatterns": [".github/**/*.yml", ".github/**/*.yaml"],
  // Test-only decoders and fixture factories are intentionally outside their
  // published package graphs and are imported by colocated tests.
  "ignoreFindings": [
    "apps/server/src/test-support/**",
    "packages/features/src/databases/test-helpers.ts"
  ],
  "workspaces": {
    "patterns": [
      "apps/*",
      "packages/features",
      "packages/markdown-text-splitter",
      "packages/page-context",
      "packages/tiptap-comment-extension"
    ]
  },
  // Pass-by-pass architecture adoption starts with the domain-neutral web
  // layer. Complete production coverage is enabled in the final pass.
  "boundaries": {
    "zones": [
      {
        "name": "web-shared",
        "patterns": ["apps/web/src/shared/**"]
      },
      {
        "name": "web-app",
        "patterns": ["apps/web/src/app/**"]
      },
      {
        "name": "web-sidebar",
        "patterns": ["apps/web/src/features/sidebar/**"]
      },
      {
        "name": "web-auth",
        "patterns": ["apps/web/src/features/auth/**"]
      },
      {
        "name": "web-settings",
        "patterns": ["apps/web/src/features/settings/**"]
      },
      {
        "name": "web-workspaces",
        "patterns": ["apps/web/src/features/workspaces/**"]
      },
      {
        "name": "web-teamspaces",
        "patterns": ["apps/web/src/features/teamspaces/**"]
      },
      {
        "name": "web-pages",
        "patterns": ["apps/web/src/features/pages/**"]
      },
      {
        "name": "web-databases",
        "patterns": ["apps/web/src/features/databases/**"]
      },
      {
        "name": "web-editor",
        "patterns": ["apps/web/src/features/editor/**"]
      },
      {
        "name": "web-ai",
        "patterns": ["apps/web/src/features/ai/**"]
      },
      {
        "name": "web-comments",
        "patterns": ["apps/web/src/features/comments/**"]
      },
      {
        "name": "web-canvas",
        "patterns": ["apps/web/src/features/canvas/**"]
      },
      {
        "name": "web-library",
        "patterns": ["apps/web/src/features/library/**"]
      },
      {
        "name": "web-meetings",
        "patterns": ["apps/web/src/features/meetings/**"]
      },
      {
        "name": "web-notion-import",
        "patterns": ["apps/web/src/features/notion-import/**"]
      },
      {
        "name": "web-tasks",
        "patterns": ["apps/web/src/features/tasks/**"]
      },
      {
        "name": "web-desktop",
        "patterns": ["apps/web/src/features/desktop/**"]
      },
      {
        "name": "web-offline",
        "patterns": ["apps/web/src/features/offline/**"]
      },
      {
        "name": "web-root",
        "patterns": ["apps/web/src/vite-env.d.ts"]
      },
      {
        "name": "web-edition-contract",
        "patterns": ["apps/web/src/edition/**"]
      },
      {
        // AppBindings is the shared composition contract inferred from Better
        // Auth and the canonical database type, not a feature implementation.
        "name": "server-bindings",
        "patterns": ["apps/server/src/shared/types.ts"]
      },
      {
        "name": "server-shared",
        "patterns": ["apps/server/src/shared/**"]
      },
      {
        // Runtime adapter declarations may reference feature-owned wire types;
        // concrete runtime implementations remain outside infrastructure.
        "name": "server-runtime-contract",
        "patterns": ["apps/server/src/infrastructure/runtime/**"]
      },
      {
        "name": "server-infrastructure",
        "patterns": ["apps/server/src/infrastructure/**"]
      },
      {
        "name": "server-app",
        "patterns": ["apps/server/src/app/**", "apps/server/src/entrypoints/**"]
      },
      {
        "name": "server-public",
        "patterns": ["apps/server/src/public/**"]
      },
      {
        "name": "server-features",
        "patterns": ["apps/server/src/features/**"]
      },
      {
        "name": "server-scripts",
        "patterns": ["apps/server/src/scripts/**"]
      },
      {
        "name": "package-features",
        "patterns": ["packages/features/src/**"]
      },
      {
        "name": "package-page-context",
        "patterns": ["packages/page-context/src/**"]
      },
      {
        "name": "package-markdown-splitter",
        "patterns": ["packages/markdown-text-splitter/src/**"]
      },
      {
        "name": "package-comment-extension",
        "patterns": ["packages/tiptap-comment-extension/src/**"]
      }
    ],
    "rules": [
      { "from": "web-shared", "allow": ["web-shared"] },
      {
        "from": "web-app",
        "allow": [
          "package-features",
          "web-app",
          "web-edition-contract",
          "web-shared",
          "web-sidebar",
          "web-auth",
          "web-settings",
          "web-workspaces",
          "web-teamspaces",
          "web-pages",
          "web-databases",
          "web-editor",
          "web-ai",
          "web-comments",
          "web-canvas",
          "web-library",
          "web-meetings",
          "web-notion-import",
          "web-tasks",
          "web-desktop",
          "web-offline"
        ]
      },
      {
        "from": "web-sidebar",
        "allow": [
          "package-features",
          "web-app",
          "web-shared",
          "web-sidebar",
          "web-teamspaces",
          "web-ai",
          "web-pages",
          "web-databases",
          "web-editor",
          "web-comments",
          "web-tasks",
          "web-desktop",
          "web-offline"
        ]
      },
      {
        // The published @zilobase/edition-web contract resolves to the
        // community edition implementation under app during local analysis.
        "from": "web-auth",
        "allow": [
          "package-features",
          "web-app",
          "web-auth",
          "web-desktop",
          "web-shared"
        ]
      },
      {
        "from": "web-settings",
        "allow": [
          "package-features",
          "web-app",
          "web-desktop",
          "web-offline",
          "web-settings",
          "web-pages",
          "web-shared"
        ]
      },
      {
        "from": "web-workspaces",
        "allow": [
          "package-features",
          "web-desktop",
          "web-notion-import",
          "web-settings",
          "web-shared",
          "web-workspaces"
        ]
      },
      {
        "from": "web-teamspaces",
        "allow": [
          "package-features",
          "web-desktop",
          "web-pages",
          "web-settings",
          "web-shared",
          "web-teamspaces"
        ]
      },
      {
        "from": "web-pages",
        "allow": [
          "package-features",
          "package-page-context",
          "web-app",
          "web-ai",
          "web-comments",
          "web-desktop",
          "web-meetings",
          "web-offline",
          "web-pages",
          "web-editor",
          "web-shared",
          "web-sidebar",
          "web-workspaces"
        ]
      },
      {
        "from": "web-databases",
        "allow": [
          "package-features",
          "web-ai",
          "web-app",
          "web-comments",
          "web-databases",
          "web-desktop",
          "web-editor",
          "web-offline",
          "web-pages",
          "web-shared"
        ]
      },
      {
        "from": "web-ai",
        "allow": [
          "package-features",
          "package-page-context",
          "web-ai",
          "web-desktop",
          "web-databases",
          "web-editor",
          "web-pages",
          "web-shared",
          "web-workspaces"
        ]
      },
      {
        "from": "web-editor",
        "allow": [
          "package-features",
          "package-page-context",
          "package-comment-extension",
          "web-ai",
          "web-comments",
          "web-databases",
          "web-desktop",
          "web-editor",
          "web-offline",
          "web-pages",
          "web-shared"
        ]
      },
      {
        "from": "web-comments",
        "allow": [
          "package-features",
          "web-comments",
          "web-desktop",
          "web-shared"
        ]
      },
      {
        "from": "web-canvas",
        "allow": ["web-canvas", "web-shared"]
      },
      {
        "from": "web-library",
        "allow": [
          "package-features",
          "web-desktop",
          "web-library",
          "web-offline",
          "web-databases",
          "web-editor",
          "web-pages",
          "web-shared",
          "web-sidebar",
          "web-teamspaces"
        ]
      },
      {
        "from": "web-meetings",
        "allow": [
          "package-features",
          "web-app",
          "web-databases",
          "web-desktop",
          "web-editor",
          "web-meetings",
          "web-pages",
          "web-shared",
          "web-workspaces"
        ]
      },
      {
        "from": "web-notion-import",
        "allow": ["package-features", "web-notion-import", "web-shared"]
      },
      {
        "from": "web-tasks",
        "allow": [
          "package-features",
          "web-databases",
          "web-editor",
          "web-shared",
          "web-tasks"
        ]
      },
      {
        "from": "web-desktop",
        "allow": [
          "package-features",
          "web-app",
          "web-auth",
          "web-desktop",
          "web-editor",
          "web-meetings",
          "web-offline",
          "web-pages",
          "web-shared"
        ]
      },
      {
        "from": "web-offline",
        "allow": ["web-desktop", "web-offline", "web-shared"]
      },
      {
        "from": "web-root",
        "allow": ["web-root"]
      },
      {
        "from": "web-edition-contract",
        "allow": ["web-edition-contract"]
      },
      {
        "from": "server-bindings",
        "allow": [
          "server-bindings",
          "server-features",
          "server-infrastructure",
          "server-shared"
        ]
      },
      {
        "from": "server-shared",
        "allow": ["package-features", "server-bindings", "server-shared"]
      },
      {
        "from": "server-runtime-contract",
        "allow": [
          "package-features",
          "server-bindings",
          "server-features",
          "server-infrastructure",
          "server-runtime-contract",
          "server-shared"
        ]
      },
      {
        "from": "server-infrastructure",
        "allow": [
          "server-bindings",
          "server-infrastructure",
          "server-runtime-contract",
          "server-shared"
        ]
      },
      {
        "from": "server-app",
        "allow": [
          "package-features",
          "server-app",
          "server-bindings",
          "server-features",
          "server-infrastructure",
          "server-public",
          "server-runtime-contract",
          "server-shared"
        ]
      },
      {
        "from": "server-public",
        "allow": [
          "package-features",
          "server-app",
          "server-bindings",
          "server-features",
          "server-infrastructure",
          "server-public",
          "server-runtime-contract",
          "server-shared"
        ]
      },
      {
        "from": "server-features",
        "allow": [
          "server-bindings",
          "server-features",
          "server-infrastructure",
          "package-features",
          "package-page-context",
          "server-runtime-contract",
          "server-shared"
        ]
      },
      {
        "from": "server-scripts",
        "allow": [
          "server-app",
          "server-bindings",
          "server-features",
          "server-infrastructure",
          "server-public",
          "server-runtime-contract",
          "server-scripts",
          "server-shared"
        ]
      },
      {
        "from": "package-features",
        "allow": [
          "package-comment-extension",
          "package-features",
          "package-markdown-splitter",
          "package-page-context"
        ]
      },
      {
        "from": "package-page-context",
        "allow": ["package-features", "package-page-context"]
      },
      {
        "from": "package-markdown-splitter",
        "allow": ["package-markdown-splitter"]
      },
      {
        "from": "package-comment-extension",
        "allow": ["package-comment-extension"]
      }
    ]
  },
