    "apps/web/src/editor/extensions/meeting/browser-meeting-recovery.ts",
    "apps/web/src/editor/extensions/meeting/meeting-transcript-text.ts",
    "apps/web/src/features/offline/documents/offline-structure-guard.ts",
    "apps/web/src/editor/paste.ts",
    "apps/web/src/editor/protected-structural-blocks.ts",
    "apps/web/src/features/pages/hooks/use-title-draft.ts",
    "apps/web/src/lib/api.ts",
    "apps/web/src/shared/lib/color-tokens.ts",
    "apps/web/src/features/offline/model/connectivity-probe.ts",
    "apps/web/src/lib/deferred-realtime.ts",
    "apps/web/src/features/desktop/deep-links/desktop-deep-link.ts",
    "apps/web/src/features/desktop/diagnostics/desktop-diagnostics.ts",
    "apps/web/src/features/desktop/network/desktop-network.ts",
    "apps/web/src/features/desktop/server/desktop-server-replacement-core.ts",
    "apps/web/src/features/desktop/server/desktop-server.ts",
    "apps/web/src/features/desktop/window/desktop-translucency.ts",
    "apps/web/src/features/pages/icons/favicon.ts",
    "apps/web/src/features/auth/lib/google-auth.ts",
    "apps/web/src/lib/image-upload.ts",
    "apps/web/src/features/workspaces/lib/invitation-link.ts",
    "apps/web/src/features/meetings/model/meeting-navigation.ts",
    "apps/web/src/features/notion-import/lib/notion-html-blocks.ts",
    "apps/web/src/features/notion-import/lib/notion-import.ts",
    "apps/web/src/features/offline/documents/offline-documents.ts",
    "apps/web/src/features/offline/documents/offline-recovery.ts",
    "apps/web/src/features/offline/model/offline-store.ts",
    "apps/web/src/shared/lib/page-icon-utils.ts",
    "apps/web/src/features/pages/publication/published-page-preferences.ts",
    "apps/web/src/features/pages/publication/published-share-access.ts",
    "apps/web/src/features/library/model/recent-navigation.ts",
    "apps/web/src/app/routing/route-error.ts",
    "apps/web/src/shared/lib/themes.ts",
    "apps/web/src/features/library/model/homepage-hierarchy.ts",
    "apps/web/src/features/pages/model/page-hierarchy-blocks.ts",
    "apps/web/src/features/teamspaces/model/team-access.ts",
    "apps/web/src/features/teamspaces/model/team-settings-tabs.ts",
    "apps/web/src/features/teamspaces/model/teamspace-filters.ts",
    "apps/web/src/features/tasks/model/tasks-model.ts",
    "apps/web/src/shared/shortcuts/editor-history.ts",
    "apps/web/src/shared/shortcuts/shortcut-definitions.ts",
    "apps/web/src/app/state/app-store.ts"
  ],
  // These workspace packages publish APIs consumed outside this repository.
  "publicPackages": [
    "@zilobase/server",
    "@zilobase/features",
    "markdown-text-splitter",
    "@zilobase/page-context",
    "@zilobase/tiptap-comment-extension"
  ],
  // Retain complete composable component APIs and namespaced public query types.
  "ignoreExports": [
    {
      "file": "apps/web/src/components/ai-elements/code-block.tsx",
      "exports": ["CodeBlockHeader", "CodeBlockTitle", "CodeBlockFilename", "CodeBlockActions", "CodeBlock", "CodeBlockCopyButton", "CodeBlockLanguageSelector", "CodeBlockLanguageSelectorTrigger", "CodeBlockLanguageSelectorValue", "CodeBlockLanguageSelectorContent", "CodeBlockLanguageSelectorItem"]
    },
    {
      "file": "apps/web/src/components/ai-elements/conversation.tsx",
      "exports": ["ConversationEmptyState", "ConversationScrollButton", "ConversationDownload"]
    },
    {
      "file": "apps/web/src/components/ai-elements/message.tsx",
      "exports": ["MessageActions", "MessageAction", "MessageBranch", "MessageBranchContent", "MessageBranchSelector", "MessageBranchPrevious", "MessageBranchNext", "MessageBranchPage", "MessageToolbar"]
    },
    {
      "file": "apps/web/src/components/ai-elements/model-selector.tsx",
      "exports": ["ModelSelectorDialog", "ModelSelectorShortcut", "ModelSelectorSeparator"]
    },
    {
      "file": "apps/web/src/components/ai-elements/prompt-input.tsx",
      "exports": ["usePromptInputController", "useProviderAttachments", "PromptInputProvider", "usePromptInputReferencedSources", "PromptInputActionAddAttachments", "PromptInputActionAddScreenshot", "PromptInputBody", "PromptInputHeader", "PromptInputActionMenu", "PromptInputActionMenuTrigger", "PromptInputActionMenuContent", "PromptInputActionMenuItem", "PromptInputSelect", "PromptInputSelectTrigger", "PromptInputSelectContent", "PromptInputSelectItem", "PromptInputSelectValue", "PromptInputHoverCard", "PromptInputHoverCardTrigger", "PromptInputHoverCardContent", "PromptInputTabsList", "PromptInputTab", "PromptInputTabLabel", "PromptInputTabBody", "PromptInputTabItem"]
    },
    {
      "file": "apps/web/src/shared/ui/alert-dialog.tsx",
      "exports": ["AlertDialogOverlay", "AlertDialogPortal"]
    },
    {
      "file": "apps/web/src/shared/ui/avatar.tsx",
      "exports": ["AvatarBadge"]
    },
    {
      "file": "apps/web/src/shared/ui/button-group.tsx",
      "exports": ["buttonGroupVariants"]
    },
    {
      "file": "apps/web/src/shared/ui/card.tsx",
      "exports": ["CardFooter", "CardAction"]
