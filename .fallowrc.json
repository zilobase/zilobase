  // The self-host test runner loads ws at runtime from a dev-only script.
  "ignoreDependencies": ["ws"],
  "duplicates": {
    // Hide pair-only clones; focus on widespread copy-paste
    // worth refactoring. Lower to 2 to report every duplicate pair.
    "minOccurrences": 3,
    // Adoption ceiling after consolidating schema timestamps, page paths, and
    // date parsing (4.44%). PR audit blocks increases; ratchet this downward.
    "threshold": 4.5
    // Common additions (uncomment to enable):
    // "ignore": [
    //   "**/lib/**",          // for repos that publish transpiled output to lib/
    //   "**/legacy/**",       // for repos with legacy-build artifacts
    //   "**/__generated__/**", // Relay, GraphQL Code Generator
    //   "**/generated/**"     // OpenAPI, Protobuf codegen
    // ]
  },
  "health": {
    // Legacy adoption ceilings are one unit above the measured repo maxima.
    // PR audit is a new-code gate; lower these as the large editor surfaces are split.
    "maxCyclomatic": 102,
    "maxCognitive": 171,
    "maxCrap": 10303,
    "maxUnitSize": 2678
  },
  "rules": {
    "unused-dependencies": "warn"
  }
}
