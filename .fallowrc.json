{
  // This file is JSONC: fallow reads these comments; generic JSON tools may not.
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/index.{js,jsx,mjs}",
    "src/main.{js,jsx,mjs}",
    // The web test runner discovers these modules with fs.readdir().
    "apps/web/test/**/*.test.mjs",
    // Runtime and developer entry points invoked outside package scripts.
    "scripts/desktop/run-signed-macos-debug.mjs",
    "scripts/selfhost/test.mjs"
  ],
  "workspaces": {
    "patterns": [
      "apps/*",
      "packages/features",
      "packages/markdown-text-splitter",
      "packages/page-context",
      "packages/tiptap-comment-extension"
    ]
  },
  // Pass-by-pass architecture adoption starts with the domain-neutral web
  // layer. Complete production coverage is enabled in the final pass.
  "boundaries": {
    "zones": [
      {
        "name": "web-shared",
        "patterns": ["apps/web/src/shared/**"]
      },
      {
        "name": "web-app",
        "patterns": ["apps/web/src/app/**"]
      },
      {
        "name": "web-sidebar",
        "patterns": ["apps/web/src/features/sidebar/**"]
      },
      {
        "name": "web-auth",
        "patterns": ["apps/web/src/features/auth/**"]
      },
      {
        "name": "web-settings",
        "patterns": ["apps/web/src/features/settings/**"]
      },
      {
        "name": "web-workspaces",
        "patterns": ["apps/web/src/features/workspaces/**"]
      },
      {
        "name": "web-teamspaces",
        "patterns": ["apps/web/src/features/teamspaces/**"]
      },
      {
        "name": "web-pages",
        "patterns": ["apps/web/src/features/pages/**"]
      },
      {
        "name": "web-comments",
        "patterns": ["apps/web/src/features/comments/**"]
      },
      {
        "name": "web-canvas",
        "patterns": ["apps/web/src/features/canvas/**"]
      },
      {
        "name": "web-library",
        "patterns": ["apps/web/src/features/library/**"]
      },
      {
        "name": "web-meetings",
        "patterns": ["apps/web/src/features/meetings/**"]
      },
      {
        "name": "web-notion-import",
        "patterns": ["apps/web/src/features/notion-import/**"]
      },
      {
        "name": "web-tasks",
        "patterns": ["apps/web/src/features/tasks/**"]
      },
      {
        "name": "web-desktop",
        "patterns": ["apps/web/src/features/desktop/**"]
      },
      {
        "name": "web-offline",
        "patterns": ["apps/web/src/features/offline/**"]
      }
    ],
    "rules": [
      { "from": "web-shared", "allow": ["web-shared"] },
      {
        "from": "web-app",
        "allow": [
          "web-app",
          "web-shared",
          "web-sidebar",
          "web-auth",
          "web-settings",
          "web-workspaces",
          "web-teamspaces",
          "web-pages",
          "web-comments",
          "web-canvas",
          "web-library",
          "web-meetings",
          "web-notion-import",
          "web-tasks",
          "web-desktop",
          "web-offline"
        ]
      },
      {
        // Temporary composition dependencies on app state/offline providers are
        // removed in the workspace and desktop/offline passes.
        "from": "web-sidebar",
        "allow": [
          "web-app",
          "web-shared",
          "web-sidebar",
          "web-teamspaces",
          "web-pages",
          "web-comments",
          "web-tasks",
          "web-desktop",
          "web-offline"
        ]
      },
      {
        // The published @zilobase/edition-web contract resolves to the
        // community edition implementation under app during local analysis.
        "from": "web-auth",
        "allow": ["web-app", "web-auth", "web-desktop", "web-shared"]
      },
      {
        // Account cleanup still coordinates app persistence and offline state;
        // the desktop/offline pass replaces these temporary app dependencies.
        "from": "web-settings",
        "allow": [
          "web-app",
          "web-desktop",
          "web-offline",
          "web-settings",
          "web-pages",
          "web-shared"
        ]
      },
      {
        "from": "web-workspaces",
        "allow": ["web-notion-import", "web-settings", "web-shared", "web-workspaces"]
      },
      {
        "from": "web-teamspaces",
        "allow": ["web-pages", "web-settings", "web-shared", "web-teamspaces"]
      },
      {
        "from": "web-pages",
        "allow": [
          "web-app",
          "web-comments",
          "web-meetings",
          "web-offline",
          "web-pages",
          "web-shared",
          "web-sidebar",
          "web-workspaces"
        ]
      },
      {
        "from": "web-comments",
        "allow": ["web-comments", "web-shared"]
      },
      {
        "from": "web-canvas",
        "allow": ["web-canvas", "web-shared"]
      },
      {
        "from": "web-library",
        "allow": [
          "web-library",
          "web-offline",
          "web-pages",
          "web-shared",
          "web-sidebar",
          "web-teamspaces"
        ]
      },
      {
        "from": "web-meetings",
        "allow": [
          "web-app",
          "web-meetings",
          "web-pages",
          "web-shared",
          "web-workspaces"
        ]
      },
      {
        "from": "web-notion-import",
        "allow": ["web-notion-import", "web-shared"]
      },
      {
        "from": "web-tasks",
        "allow": ["web-shared", "web-tasks"]
      },
      {
        // Desktop state cleanup still coordinates the app stores; this edge is
        // removed when final state ownership is ratcheted in the boundary pass.
        "from": "web-desktop",
        "allow": [
          "web-app",
          "web-auth",
          "web-desktop",
          "web-offline",
          "web-pages",
          "web-shared"
        ]
      },
      {
        "from": "web-offline",
        "allow": ["web-desktop", "web-offline", "web-shared"]
      }
    ]
  },
  // The custom web test harness bundles these literal loadModule() paths.
  "dynamicallyLoaded": [
    "apps/web/src/features/comments/model/yjs-comments.ts",
    "apps/web/src/components/ai-elements/integration-tool-presentation.ts",
