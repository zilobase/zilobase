{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["replicaCount", "development", "debug", "realtime", "gmail", "image", "existingSecret", "config", "networkPolicy", "trustedCa"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "development": {
      "type": "object",
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    },
    "debug": {
      "type": "object",
      "required": ["enabled", "port"],
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1024, "maximum": 65535 }
      }
    },
    "realtime": {
      "type": "object",
      "required": ["enabled", "existingSecret", "secretKey", "networkCIDR", "port"],
      "properties": {
        "enabled": { "type": "boolean" },
        "existingSecret": { "type": "string" },
        "secretKey": { "type": "string", "minLength": 1 },
        "networkCIDR": { "type": "string", "minLength": 3 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "gmail": {
      "type": "object",
      "required": ["enabled", "googleClientId", "pubsubTopic", "pubsubPushAudience", "pubsubServiceAccountEmail", "pubsubSubscription", "networkCIDR"],
      "properties": {
        "enabled": { "type": "boolean" },
        "googleClientId": { "type": "string" },
        "pubsubTopic": { "type": "string" },
        "pubsubPushAudience": { "type": "string" },
        "pubsubServiceAccountEmail": { "type": "string" },
        "pubsubSubscription": { "type": "string" },
        "networkCIDR": { "type": "string", "minLength": 3 }
      }
    },
    "existingSecret": { "type": "string", "minLength": 1 },
    "image": {
      "type": "object",
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "const": "ghcr.io/zilobase/zilobase" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "config": {
      "type": "object",
      "required": ["externalUrl", "s3Endpoint", "s3PublicEndpoint", "s3Bucket", "smtpHost"],
      "properties": {
        "externalUrl": { "type": "string", "pattern": "^https?://" },
        "s3Endpoint": { "type": "string", "pattern": "^https?://" },
        "s3PublicEndpoint": { "type": "string", "pattern": "^https?://" },
        "s3Bucket": { "type": "string", "minLength": 1 },
        "smtpHost": { "type": "string", "minLength": 1 }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "healthProbeCIDRs", "postgresCIDR", "s3CIDR", "smtpCIDR"],
      "properties": {
        "enabled": { "type": "boolean" },
        "healthProbeCIDRs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        },
        "postgresCIDR": { "type": "string", "minLength": 3 },
        "s3CIDR": { "type": "string", "minLength": 3 },
        "smtpCIDR": { "type": "string", "minLength": 3 }
      }
    },
    "trustedCa": {
      "type": "object",
      "required": ["configMapName", "key"],
      "properties": {
        "configMapName": { "type": "string" },
        "key": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [{
    "if": { "properties": { "development": { "properties": { "enabled": { "const": false } } } } },
    "then": {
      "properties": {
        "config": {
          "properties": {
            "externalUrl": { "pattern": "^https://" },
            "s3Endpoint": { "pattern": "^https://" },
            "s3PublicEndpoint": { "pattern": "^https://" }
          }
        }
      }
    }
  }, {
    "if": { "properties": { "replicaCount": { "minimum": 2 } } },
    "then": {
      "properties": {
        "realtime": {
          "properties": {
            "enabled": { "const": true },
            "existingSecret": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }, {
    "if": { "properties": { "gmail": { "properties": { "enabled": { "const": true } } } } },
    "then": {
      "properties": {
        "gmail": {
          "properties": {
            "googleClientId": { "pattern": "^[A-Za-z0-9._-]+\\.apps\\.googleusercontent\\.com$" },
            "pubsubTopic": { "pattern": "^projects/.+/topics/.+$" },
            "pubsubPushAudience": { "pattern": "^https://.+/mail/google/pubsub$" },
            "pubsubServiceAccountEmail": { "pattern": "^[^@]+@[^@]+\\.iam\\.gserviceaccount\\.com$" },
            "pubsubSubscription": { "pattern": "^projects/.+/subscriptions/.+$" }
          }
        }
      }
    }
  }]
}
