{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["replicaCount", "realtime", "image", "existingSecret", "config", "networkPolicy", "trustedCa"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "realtime": {
      "type": "object",
      "required": ["enabled", "existingSecret", "secretKey", "networkCIDR", "port"],
      "properties": {
        "enabled": { "type": "boolean" },
        "existingSecret": { "type": "string" },
        "secretKey": { "type": "string", "minLength": 1 },
        "networkCIDR": { "type": "string", "minLength": 3 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "existingSecret": { "type": "string", "minLength": 1 },
    "image": {
      "type": "object",
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "const": "ghcr.io/zilobase/zilobase" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "config": {
      "type": "object",
      "required": ["externalUrl", "s3Endpoint", "s3PublicEndpoint", "s3Bucket", "smtpHost"],
      "properties": {
        "externalUrl": { "type": "string", "pattern": "^https://" },
        "s3Endpoint": { "type": "string", "pattern": "^https://" },
        "s3PublicEndpoint": { "type": "string", "pattern": "^https://" },
        "s3Bucket": { "type": "string", "minLength": 1 },
        "smtpHost": { "type": "string", "minLength": 1 }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "healthProbeCIDRs", "postgresCIDR", "s3CIDR", "smtpCIDR"],
      "properties": {
        "enabled": { "type": "boolean" },
        "healthProbeCIDRs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        },
        "postgresCIDR": { "type": "string", "minLength": 3 },
        "s3CIDR": { "type": "string", "minLength": 3 },
        "smtpCIDR": { "type": "string", "minLength": 3 }
      }
    },
    "trustedCa": {
      "type": "object",
      "required": ["configMapName", "key"],
      "properties": {
        "configMapName": { "type": "string" },
        "key": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [{
    "if": { "properties": { "replicaCount": { "minimum": 2 } } },
    "then": {
      "properties": {
        "realtime": {
          "properties": {
            "enabled": { "const": true },
            "existingSecret": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }]
}
