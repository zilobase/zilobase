# Copy this file to .env.selfhost for a production deployment. The base
# Compose file has no secret or localhost fallbacks.

# Pin a release tag or, preferably, the digest printed by the registry.
ZILOBASE_IMAGE=ghcr.io/zilobase/zilobase:v0.0.30

# Optional shared realtime broker. Required by multi-replica Helm deployments.
REALTIME_REDIS_URL=

# Caddy obtains TLS certificates for both DNS names. Subpath hosting is not
# supported. S3_PUBLIC_ENDPOINT must exactly match the storage origin.
ZILOBASE_SITE_ADDRESS=notes.example.com
ZILOBASE_STORAGE_SITE_ADDRESS=objects.notes.example.com
CLIENT_URL=https://notes.example.com
BETTER_AUTH_URL=https://notes.example.com
S3_PUBLIC_ENDPOINT=https://objects.notes.example.com

# Generate URL-safe random values, for example: openssl rand -hex 48
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
ZILOBASE_BOOTSTRAP_TOKEN=replace-with-at-least-32-random-characters
# Optional dedicated signing key for collaboration and mail realtime tickets.
# Falls back to BETTER_AUTH_SECRET.
COLLABORATION_SECRET=

# Optional server-side social login configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail mailbox integration. Use a separate Google OAuth Web application client.
# The callback is BETTER_AUTH_URL followed by /mail/oauth/google/callback.
MAIL_ENABLED=false
DATABASE_AUTOMATIONS_ENABLED=false
DATABASE_AUTOMATIONS_EXECUTION_DISABLED=true
GMAIL_GOOGLE_CLIENT_ID=
GMAIL_GOOGLE_CLIENT_SECRET=
# Generate once with `openssl rand -base64 32`, back it up, and never rotate it
# without a credential re-encryption procedure.
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_PUSH_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT_EMAIL=
GMAIL_PUBSUB_SUBSCRIPTION=

# Postgres. Keep passwords URL-safe because Compose builds DATABASE_URL.
POSTGRES_DB=zilobase
POSTGRES_USER=zilobase
POSTGRES_PASSWORD=replace-with-a-url-safe-random-password

# MinIO object storage.
MINIO_BUCKET=zilobase
MINIO_ROOT_USER=zilobase
MINIO_ROOT_PASSWORD=replace-with-a-random-minio-password

# SMTP email delivery.
EMAIL_FROM=Zilobase <hello@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password

# Optional AI support.
OPENAI_API_KEY=
AI_PROVIDER_CREDENTIAL_ENCRYPTION_KEY=
AI_PROVIDER_ALLOWED_BASE_URLS=
AI_LEGACY_CHAT_ENABLED=false
# Ask AI has safe operational defaults. Override these only after reviewing
# docs/ask-ai-operations.md.
AI_AGENT_MAX_CONCURRENT_TURNS_PER_USER=
AI_AGENT_MAX_CONCURRENT_TURNS_PER_WORKSPACE=
AI_AGENT_MAX_TURNS_PER_USER_PER_DAY=
AI_AGENT_MAX_TOKENS_PER_USER_PER_DAY=
AI_AGENT_MAX_UPLOAD_BYTES_PER_USER_PER_DAY=
AI_AGENT_MAX_ARTIFACTS_PER_USER_PER_DAY=
AI_AGENT_MAX_ARTIFACT_BYTES_PER_USER_PER_DAY=
AI_AGENT_AUDIT_RETENTION_DAYS=
MEETING_BLOCK_ENABLED=false
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-live-transcribe
MEETING_AUDIO_WEBSOCKET_URL=
