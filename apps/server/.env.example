DATABASE_URL=postgres://YOUR_LOCAL_POSTGRES_USER:YOUR_LOCAL_POSTGRES_PASSWORD@localhost:5432/zilobase
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
CLIENT_URL=http://localhost:1420,http://localhost:4173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public OAuth client ID created with application type "Desktop app".
GOOGLE_DESKTOP_CLIENT_ID=
# Gmail uses a separate Web application OAuth client. The exact redirect URI is
# BETTER_AUTH_URL/mail/oauth/google/callback. Leave every GMAIL_* value empty to
# run without Gmail; see docs/mail/gmail-deployment.md.
GMAIL_GOOGLE_CLIENT_ID=
GMAIL_GOOGLE_CLIENT_SECRET=
# Generate with: openssl rand -base64 32
GMAIL_TOKEN_ENCRYPTION_KEY=
# Push is optional for loopback development and required for production Gmail.
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_PUSH_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT_EMAIL=
GMAIL_PUBSUB_SUBSCRIPTION=
# Optional; defaults to BETTER_AUTH_SECRET when omitted.
COLLABORATION_SECRET=
COLLABORATION_WEBSOCKET_URL=ws://localhost:3000/collaboration
# Optional for alternate dev ports:
# CLIENT_URL=http://localhost:1420,http://localhost:4173,http://localhost:1422

# Optional SMTP delivery. Without SMTP_HOST, auth emails are printed to logs.
EMAIL_FROM=Zilobase <hello@example.com>
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# Image uploads
# Use "s3" locally to exercise S3-compatible presigned URLs.
IMAGE_STORAGE_MODE=s3
OPENAI_API_KEY=
# Required to save workspace BYOK credentials. Generate 32 random bytes and
# base64-encode them, for example: openssl rand -base64 32
AI_PROVIDER_CREDENTIAL_ENCRYPTION_KEY=
# Optional comma-separated HTTPS origins for operator-approved custom endpoints.
AI_PROVIDER_ALLOWED_BASE_URLS=
# Emergency compatibility only. Canonical server-owned turns are the default.
AI_LEGACY_CHAT_ENABLED=false
# Ask AI operational limits (optional; these are the defaults).
AI_AGENT_MAX_CONCURRENT_TURNS_PER_USER=2
AI_AGENT_MAX_CONCURRENT_TURNS_PER_WORKSPACE=24
AI_AGENT_MAX_TURNS_PER_USER_PER_DAY=200
AI_AGENT_MAX_TOKENS_PER_USER_PER_DAY=500000
AI_AGENT_MAX_UPLOAD_BYTES_PER_USER_PER_DAY=262144000
AI_AGENT_MAX_ARTIFACTS_PER_USER_PER_DAY=50
AI_AGENT_MAX_ARTIFACT_BYTES_PER_USER_PER_DAY=262144000
AI_AGENT_MAX_FILES_PER_TURN=5
AI_AGENT_MAX_INPUT_MESSAGES=500
AI_AGENT_MAX_INPUT_CHARACTERS=250000
AI_AGENT_MAX_STEPS=15
AI_AGENT_MAX_OUTPUT_TOKENS=1600
AI_AGENT_MAX_PROVIDER_RETRIES=2
AI_AGENT_TURN_TIMEOUT_MS=180000
AI_AGENT_STREAM_STEP_TIMEOUT_MS=60000
AI_AGENT_STREAM_CHUNK_TIMEOUT_MS=30000
AI_AGENT_AUDIT_RETENTION_DAYS=90
AI_AGENT_CLEANUP_BATCH_SIZE=100
# Meeting blocks and near-live transcription.
MEETING_BLOCK_ENABLED=false
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-live-transcribe
# Optional public WebSocket override, for example wss://api.example.com/meeting-audio.
MEETING_AUDIO_WEBSOCKET_URL=
# Optional public WebSocket override for collaborative meeting notes and summaries.
MEETING_COLLABORATION_WEBSOCKET_URL=
IMAGE_UPLOAD_MAX_BYTES=10485760
IMAGE_UPLOAD_URL_TTL_SECONDS=600
IMAGE_READ_URL_TTL_SECONDS=300
S3_BUCKET_NAME=zilobase-images
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
