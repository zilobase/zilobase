{
  "name": "@zilobase/server",
  "version": "0.0.55",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/public/adapter-api.ts",
      "default": "./src/public/adapter-api.ts"
    },
    "./adapter-api": {
      "types": "./src/public/adapter-api.ts",
      "default": "./src/public/adapter-api.ts"
    },
    "./node-adapter-api": {
      "types": "./src/public/node-adapter-api.ts",
      "default": "./src/public/node-adapter-api.ts"
    },
    "./realtime-api": {
      "types": "./src/public/realtime-api.ts",
      "default": "./src/public/realtime-api.ts"
    },
    "./operations": {
      "types": "./src/public/operations.ts",
      "default": "./src/public/operations.ts"
    }
  },
  "scripts": {
    "dev": "ZILOBASE_AUTO_MIGRATE=true ZILOBASE_ENV_FILE=../../.env.development dotenvx run --ignore=MISSING_ENV_FILE -f ../../.env.development --quiet -- tsx watch --include 'drizzle/**/*.sql' --include '../../packages/features/src/databases/**/*.ts' src/entrypoints/serverful.ts",
    "dev:node": "ZILOBASE_AUTO_MIGRATE=true ZILOBASE_ENV_FILE=../../.env.development dotenvx run --ignore=MISSING_ENV_FILE -f ../../.env.development --quiet -- tsx watch --include 'drizzle/**/*.sql' --include '../../packages/features/src/databases/**/*.ts' src/entrypoints/serverful.ts",
    "build": "npm run tokens:check --prefix ../.. && npm run typecheck",
    "build:node": "npm run tokens:check --prefix ../.. && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "test:insert-database-block": "vitest run src/services/databases/setup/insert-database-block.test.ts",
    "test:database-property-config": "vitest run src/services/databases/schema/config.test.ts",
    "test:databases": "vitest run src/services/databases/schema/config.test.ts src/services/databases/mutations/commit.test.ts src/services/databases/setup/insert-database-block.test.ts",
    "test:databases:persistence": "tsx src/scripts/verify-database-controller.ts",
    "test:collaboration": "vitest run src/services/collaboration",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:full": "COVERAGE_FULL=1 vitest run --coverage",
    "test:query-regression": "vitest run src/services/access src/services/databases src/services/memberships src/services/page-guests src/routes/access src/routes/databases src/routes/page-guests",
    "test:quality": "npm run test:coverage:full && npm run test:query-regression && npm run build",
    "test:api-keys": "ZILOBASE_ENV_FILE=../../.env.development dotenvx run --ignore=MISSING_ENV_FILE -f ../../.env.development --quiet -- tsx src/scripts/test-api-key-flow.ts",
    "test:flow": "ZILOBASE_ENV_FILE=../../.env.development dotenvx run --ignore=MISSING_ENV_FILE -f ../../.env.development --quiet -- tsx src/scripts/simulate-user-flow.ts",
    "teamspaces:check": "dotenvx run --ignore=MISSING_ENV_FILE -f ../../.env.development --quiet -- tsx src/scripts/check-teamspaces.ts",
    "db:generate": "ZILOBASE_ENV_FILE=../../.env.development dotenvx run --ignore=MISSING_ENV_FILE -f ../../.env.development --quiet -- drizzle-kit generate",
    "db:migrate": "ZILOBASE_ENV_FILE=../../.env.development dotenvx run --ignore=MISSING_ENV_FILE -f ../../.env.development --quiet -- tsx src/scripts/migrate.ts",
    "db:migrate:production": "tsx src/scripts/migrate.ts",
    "db:seed:demo": "dotenvx run --ignore=MISSING_ENV_FILE -f ../../.env.development --quiet -- tsx src/scripts/seed-demo.ts",
    "db:reset": "ZILOBASE_ENV_FILE=../../.env.development dotenvx run --ignore=MISSING_ENV_FILE -f ../../.env.development --quiet -- tsx src/scripts/reset-database.ts && npm run db:migrate",
    "db:studio": "drizzle-kit studio --host 127.0.0.1 --port 4983"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.97",
    "@better-auth/api-key": "1.7.14",
    "@better-auth/expo": "1.7.14",
    "@better-auth/oauth-provider": "1.7.14",
    "@dotenvx/dotenvx": "1.75.1",
    "@hocuspocus/extension-database": "^4.3.0",
    "@hocuspocus/extension-redis": "^4.6.0",
    "@hocuspocus/server": "^4.3.0",
    "@hocuspocus/transformer": "^4.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@tiptap/pm": "^3.23.6",
    "@zilobase/features": "file:../../packages/features",
    "@zilobase/html-to-page": "file:../../packages/html-to-page",
    "@zilobase/page-context": "file:../../packages/page-context",
    "@zilobase/runtime-adapter": "file:../../packages/runtime-adapter",
    "@zilobase/runtime-ports": "file:../../packages/runtime-ports",
    "ai": "7.0.145",
    "better-auth": "1.7.14",
    "bullmq": "6.3.11",
    "crossws": "^0.4.9",
    "drizzle-orm": "^0.45.2",
    "effect": "4.0.0-rc.113",
    "fflate": "^0.8.3",
    "hono": "^4.13.7",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "js-tiktoken": "1.0.21",
    "pg": "^8.21.0",
    "ws": "^8.21.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.31",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.22.3",
    "vitest": "^4.1.11"
  }
}
