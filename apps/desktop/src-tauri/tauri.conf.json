{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zilobase-client",
  "version": "0.0.31",
  "identifier": "com.zilobase",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --prefix ../web",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "zilobase-client",
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "width": 900,
        "height": 650,
        "minWidth": 900,
        "minHeight": 650,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "useLocalToolsDir": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["zilobase"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3QkQ4Mjk3QjVCN0ExQjcKUldTM29iZTFsNEs5TnlDdUNWQjBLVUxGRzlpdkhzTUJXMmJtQmVONjlLanFuRTMxOVd2SnJDTlkK",
      "endpoints": [
        "https://github.com/zilobase/zilobase/releases/latest/download/latest.json"
      ]
    }
  }
}
