{
  "name": "@zilobase/desktop",
  "version": "0.0.55",
  "description": "Zilobase desktop client",
  "homepage": "https://zilobase.com",
  "author": "Zilobase <hello@zilobase.com>",
  "desktopName": "com.zilobase",
  "main": "electron/main/index.mjs",
  "license": "MIT",
  "scripts": {
    "dev": "node electron/dev.mjs",
    "build": "npm run build:electron",
    "test:selfhost": "node e2e/electron-selfhost.mjs",
    "dev:electron": "node electron/sidecar/build.mjs && electron .",
    "build:electron": "npm run build --prefix ../web && node electron/sidecar/build.mjs && electron-builder --config electron-builder.yml --publish never",
    "build:electron:sidecar": "node electron/sidecar/build.mjs",
    "pack:electron": "node electron/sidecar/build.mjs && electron-builder --dir --config electron-builder.yml",
    "test:electron:smoke": "node e2e/electron-smoke.mjs",
    "test:electron:selfhost": "node e2e/electron-selfhost.mjs",
    "test:electron:oauth": "node e2e/electron-oauth.mjs"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "1.75.1",
    "electron": "44.4.3",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "fflate": "0.8.3",
    "semver": "^6.3.1"
  }
}
