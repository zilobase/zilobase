{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    ".agents/**",
    ".claude/**",
    "apps/server/drizzle/meta/**",
    "deploy/helm/zilobase/templates/**",
    "scripts/refactor/public-exports-baseline.json"
  ]
}
