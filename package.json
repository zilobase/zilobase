{
  "name": "zilobase",
  "version": "0.0.34",
  "private": true,
  "license": "MIT",
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "workspaces": [
    "apps/*",
    "packages/features",
    "packages/markdown-text-splitter",
    "packages/page-context",
    "packages/tiptap-comment-extension"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @zilobase/web",
    "build": "npm run build --workspace @zilobase/web",
    "dev:web": "npm run dev --workspace @zilobase/web",
    "build:web": "npm run build --workspace @zilobase/web",
    "test:web": "npm run test --workspace @zilobase/web",
    "test:update-local": "node scripts/test-desktop-update.mjs",
    "test:desktop:selfhost": "node apps/desktop/e2e/selfhost.mjs",
    "dev:desktop": "npm run dev --workspace @zilobase/desktop",
    "build:desktop": "npm run build --workspace @zilobase/desktop",
    "dev:server": "npm run dev --workspace @zilobase/server",
    "build:server": "npm run build --workspace @zilobase/server",
    "test:server": "npm run test:quality --workspace @zilobase/server",
    "db:migrate": "npm run db:migrate --workspace @zilobase/server",
    "selfhost:up": "node scripts/selfhost.mjs up",
    "selfhost:logs": "node scripts/selfhost.mjs logs",
    "selfhost:down": "node scripts/selfhost.mjs down",
    "selfhost:reset": "node scripts/selfhost.mjs reset",
    "test:selfhost": "node scripts/selfhost.mjs test",
    "test:selfhost:upgrade": "node scripts/test-selfhost-upgrade.mjs",
    "release": "node scripts/release.mjs",
    "version:set": "node scripts/set-version.mjs"
  },
  "devDependencies": {
    "webdriverio": "^9.30.1",
    "ws": "^8.21.0"
  }
}
