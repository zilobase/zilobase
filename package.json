{
  "name": "zilobase",
  "version": "0.0.55",
  "private": true,
  "license": "MIT",
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shiki": "4.1.0"
  },
  "workspaces": [
    "apps/*",
    "packages/features",
    "packages/html-to-page",
    "packages/markdown-text-splitter",
    "packages/page-context",
    "packages/runtime-ports",
    "packages/runtime-adapter",
    "packages/tiptap-comment-extension"
  ],
  "scripts": {
    "dev": "node scripts/dev/workspace.mjs",
    "preview": "node scripts/dev/cli.mjs preview",
    "setup": "node scripts/dev/cli.mjs setup",
    "setup:check": "node scripts/dev/cli.mjs setup-check",
    "build": "npm run build --workspace @zilobase/web && npm run build --workspace @zilobase/server",
    "dev:clipper": "npm run dev --workspace @zilobase/clipper",
    "build:clipper": "npm run build --workspace @zilobase/clipper",
    "test:web": "npm run test --workspace @zilobase/web",
    "test:update-local": "node scripts/desktop/test-update.mjs",
    "test:desktop:selfhost": "node apps/desktop/e2e/selfhost.mjs",
    "test:desktop:electron:selfhost": "node apps/desktop/e2e/electron-selfhost.mjs",
    "tokens:sync": "node scripts/colors/sync-color-tokens.mjs",
    "tokens:check": "node scripts/colors/sync-color-tokens.mjs --check",
    "dev:desktop": "node scripts/desktop/dev.mjs",
    "dev:desktop:node": "node scripts/desktop/profile.mjs node",
    "build:desktop": "npm run build --workspace @zilobase/desktop",
    "dev:doctor": "node scripts/dev/cli.mjs doctor",
    "dev:setup": "node scripts/dev/cli.mjs env-setup",
    "dev:status": "node scripts/dev/cli.mjs status",
    "dev:logs": "node scripts/dev/cli.mjs logs",
    "dev:down": "node scripts/dev/cli.mjs down",
    "dev:reset": "node scripts/dev/cli.mjs reset",
    "env:check": "node scripts/dev/cli.mjs env-check",
    "env:encrypt": "node scripts/dev/cli.mjs env-encrypt",
    "env:decrypt": "node scripts/dev/cli.mjs env-decrypt",
    "dev:k8s:community": "node scripts/dev/cli.mjs k8s --target community",
    "dev:k8s:rebuild": "node scripts/dev/cli.mjs k8s-rebuild",
    "dev:k8s:logs": "node scripts/dev/cli.mjs k8s-logs",
    "dev:k8s:down": "node scripts/dev/cli.mjs k8s-down",
    "quality:web-bundle": "node scripts/web/check-bundle-budget.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:packages": "npm test --workspace @zilobase/features && npm test --workspace @zilobase/page-context && npm test --workspace @zilobase/html-to-page",
    "verify:core": "npm run tokens:check && npm run test:tooling && npm run test:community-boundary && npm run typecheck && npm run test:packages && npm run test:web && npm run build && npm run test:server",
    "verify:desktop": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --check && cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --locked --all-targets -- -D warnings && cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml --locked",
    "verify:architecture": "npm run test:architecture",
    "verify": "npm run verify:core && npm run verify:desktop && npm run verify:architecture",
    "verify:push": "node scripts/git/pre-push.mjs",
    "verify:commit": "node scripts/git/pre-push.mjs --staged",
    "hooks:install": "node scripts/git/install-hooks.mjs",
    "test:server": "npm run test:quality --workspace @zilobase/server",
    "test:databases:acceptance": "node scripts/databases/test-acceptance.mjs",
    "test:databases:acceptance:full": "node scripts/databases/test-acceptance.mjs --full",
    "db:migrate": "npm run db:migrate --workspace @zilobase/server",
    "deps:check": "node scripts/check-dep-alignment.mjs --check-all",
    "db:studio": "node scripts/dev/cli.mjs studio",
    "selfhost:up": "node scripts/selfhost/manage.mjs up",
    "selfhost:logs": "node scripts/selfhost/manage.mjs logs",
    "selfhost:down": "node scripts/selfhost/manage.mjs down",
    "selfhost:reset": "node scripts/selfhost/manage.mjs reset",
    "test:selfhost": "node scripts/selfhost/manage.mjs test",
    "test:selfhost:upgrade": "node scripts/selfhost/test-upgrade.mjs",
    "test:dev-workflow": "node --test scripts/dev/dev-workflow.test.mjs",
    "test:tooling": "node --test scripts/dev/dev-workflow.test.mjs scripts/selfhost/cookie-jar.test.mjs scripts/release/set-version.test.mjs scripts/git/pre-push.test.mjs scripts/check-dep-alignment.test.mjs",
    "test:k8s:community": "node scripts/dev/cli.mjs k8s-smoke --target community",
    "test:mail:deployment": "node --test scripts/mail/gmail-deployment-config.test.mjs && node scripts/mail/check-documentation.mjs",
    "test:community-boundary": "node --test scripts/community-boundary.test.mjs && node scripts/check-community-boundary.mjs",
    "mail:config:check": "dotenvx run --ignore=MISSING_ENV_FILE --quiet -- node scripts/mail/check-gmail-config.mjs",
    "env": "dotenvx",
    "release": "npm run tokens:check && npm run test:community-boundary && node scripts/release/release.mjs",
    "version:set": "node scripts/release/set-version.mjs",
    "test:architecture": "node --test scripts/refactor/check-architecture.test.mjs scripts/refactor/check-runtime-ports.test.mjs && node scripts/refactor/check-architecture.mjs && node scripts/refactor/check-runtime-ports.mjs",
    "test:mail:integration": "node scripts/mail/test-integration.mjs",
    "test:mail:browser": "playwright test --config scripts/mail/e2e/playwright.config.mjs",
    "test:calendar:integration": "node scripts/calendar/test-integration.mjs",
    "test:calendar:browser": "playwright test --config scripts/calendar/e2e/playwright.config.mjs"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "1.75.1",
    "@tanstack/react-query": "5.101.4",
    "pg": "^8.22.0",
    "react-dom": "19.2.3",
    "react": "19.2.3",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^4.1.11",
    "postcss": "^8.5.26",
    "typescript": "6.0.3",
    "webdriverio": "^9.30.1",
    "ws": "^8.21.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
